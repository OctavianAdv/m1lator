# --- BlueStacks files: never commit (proprietary) ---
*.dll
*.exe
*.sys
*.pdb
*.r0
*.rc
*.lib
*.vdi
decomp/
backup/

# --- build output ---
build/
src/*/bin/
src/*/obj/

# --- our own prebuilt tools (.NET Framework 4.8, ~1 MB): committed so every download works ---
!/bin/
!/bin/M1lator.Tool.exe
!/bin/M1lator.Tool.exe.config
!/bin/M1lator.ThemeGen.exe
!/bin/M1lator.ThemeGen.exe.config
!/bin/M1lator.Boost.dll
!/bin/dnlib.dll
!/bin/M1lator.Client.dll
